{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "globals": {
      "__DEV__": true
    },
    "setupFiles": ["./jest.setup.js"],
    "testMatch": [
      "<rootDir>/lib/**/__tests__/**/*.test.ts",
      "<rootDir>/app/**/__tests__/**/*.test.ts",
      "<rootDir>/app/**/__tests__/**/*.test.tsx"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "caller": {
            "name": "metro",
            "bundler": "metro",
            "platform": "ios"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|pocketbase|libsodium-wrappers|libsodium|zustand|date-fns)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/./$1"
    }
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "expo": "~54.0.33",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-haptics": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "libsodium-wrappers": "^0.7.15",
    "pocketbase": "^0.25.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "^55.0.16",
    "jest": "^30.3.0",
    "jest-expo": "^55.0.15",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}

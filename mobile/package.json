{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "jest": {
    "globals": {
      "__DEV__": true
    },
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/lib/**/__tests__/**/*.test.ts",
      "<rootDir>/app/**/__tests__/**/*.test.ts",
      "<rootDir>/app/**/__tests__/**/*.test.tsx"
    ],
    "transform": {
      "\\.[jt]sx?$": [
        "babel-jest",
        {
          "caller": {
            "name": "metro",
            "bundler": "metro",
            "platform": "ios"
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|pocketbase|libsodium-wrappers|libsodium|zustand|date-fns)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/./$1"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "^55.0.11",
    "date-fns": "^4.1.0",
    "expo": "~55.0.23",
    "expo-auth-session": "~55.0.15",
    "expo-constants": "~55.0.16",
    "expo-device": "~55.0.16",
    "expo-haptics": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.22",
    "expo-router": "~5.1.11",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.15",
    "libsodium-wrappers": "0.7.15",
    "pocketbase": "^0.26.8",
    "react": "19.2.6",
    "react-dom": "^19.2.0",
    "react-native": "0.83.9",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.2.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "~0.8.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~55.0.21",
    "jest": "^30.4.1",
    "jest-expo": "~55.0.17",
    "react-test-renderer": "19.2.6",
    "typescript": "~5.9.3"
  },
  "private": true
}

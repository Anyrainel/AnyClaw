{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*",
    "vitest.config.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist"
  ]
}

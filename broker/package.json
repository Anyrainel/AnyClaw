{
  "name": "@anyclaw/broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "@lucia-auth/adapter-postgresql": "^3.1.2",
    "cbor-x": "^1.6.4",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "libsodium-wrappers": "0.7.15",
    "lucia": "^3.2.2",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.15.14",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "nock": "^14.0.15",
    "testcontainers": "^11.14.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "zod": "^3.25.76"
  }
}

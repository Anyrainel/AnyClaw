{
  "name": "@anyclaw/broker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@lucia-auth/adapter-postgresql": "^3.1.2",
    "cbor-x": "^1.5.9",
    "fastify": "^5.8.0",
    "jose": "^5.9.3",
    "libsodium-wrappers": "0.7.15",
    "lucia": "^3.2.0",
    "pino": "^9.4.0",
    "postgres": "^3.4.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.13.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.12",
    "nock": "^13.5.5",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "zod": "^3.25.76"
  }
}
